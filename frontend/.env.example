# Copy this file to .env for local dev (defaults already match local dev if omitted),
# or set these in your hosting provider's dashboard (e.g. Vercel project settings) for production.

# Backend API base URL — no trailing slash.
# Local dev default: http://localhost:5000
# Production: your deployed backend's URL (e.g. https://your-app.onrender.com)
VITE_API_BASE_URL=http://localhost:5000
