# Copy this file to .env for local dev, or set these in your hosting
# provider's dashboard (e.g. Render's environment variables) for production.

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=db_coastalerosion
DB_PASSWORD=
DB_PORT=5432

# Email Configuration — sent via Brevo's API (not SMTP), since most
# free-tier hosts block outbound SMTP ports.
# EMAIL_USER is the "from" address — must be verified as a sender in your
# Brevo account (Senders, Domains & Dedicated IPs > Senders).
# BREVO_API_KEY comes from Brevo dashboard > SMTP & API > API Keys.
EMAIL_USER=
BREVO_API_KEY=

# JWT Configuration — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin allowed by CORS — no trailing slash.
# Local dev default (used if unset): http://localhost:5173
# Production: your deployed frontend's URL (e.g. https://your-domain.com)
FRONTEND_URL=http://localhost:5173

# Supabase — used for Storage (uploaded files, and db backups via
# backend/scripts/dbBackup.js), separate from the DB_* Postgres connection
# above even though both point at the same Supabase project.
# SUPABASE_URL is your project's API URL (Project Settings > API).
# SUPABASE_SERVICE_ROLE_KEY is the service_role secret key (same page) —
# bypasses Row Level Security, keep this out of any client-side code.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — where backend/scripts/dbBackup.js sends a failure alert if the
# scheduled daily backup doesn't complete. Falls back to EMAIL_USER if unset.
BACKUP_ALERT_EMAIL=
