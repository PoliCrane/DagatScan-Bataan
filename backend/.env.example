# Copy this file to .env for local dev, or set these in your hosting
# provider's dashboard (e.g. Render's environment variables) for production.

# Database Configuration
DB_USER=postgres
DB_HOST=localhost
DB_NAME=db_coastalerosion
DB_PASSWORD=
DB_PORT=5432

# Email Configuration (Gmail app password, not your regular password)
EMAIL_USER=
EMAIL_PASS=

# JWT Configuration — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Frontend origin allowed by CORS — no trailing slash.
# Local dev default (used if unset): http://localhost:5173
# Production: your deployed frontend's URL (e.g. https://your-domain.com)
FRONTEND_URL=http://localhost:5173
